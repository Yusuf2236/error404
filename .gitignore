# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + nested, e.g. admin-side/)
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (root + admin-side build caches)
.next/
**/.next/
.next-admin/
**/.next-admin/
/out/

# production
/build

# Flutter / Dart build artifacts
flutter_app/build/
flutter_app/.dart_tool/
**/.dart_tool/
*.dill
*.dill.track.dill
*.so

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules

# Native build artifacts
vipuzbe-debug.apk
*.apk
/native/www/icon.png

# Customer PII data store — never commit
src/app/data/bookings.json
admin-side/src/app/data/bookings.json
